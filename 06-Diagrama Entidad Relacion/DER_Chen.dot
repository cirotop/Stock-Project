// https://edotor.net
//
// Diagrama Entidad-Relacion - Notacion de Chen - Stock Project
// [rectangulo] = entidad   <rombo> = relacion (sin atributos)   (elipse) = atributo
// atributo subrayado = clave    elipse punteada = atributo derivado
//
// El vencimiento se maneja por LOTE: cada caja ingresa con su numero de lote
// y a ese lote se le asigna la fecha de vencimiento impresa (RN-03, RN-04).

graph DER_Chen {
  graph [charset="UTF-8", overlap=false, splines=true, nodesep=0.45, ranksep=0.75, fontname="Helvetica"];
  node  [fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=10, len=1.6];

  // ============ Entidades ============
  node [shape=box, style=filled, fillcolor="#DDE7F3", color="#444444", width=1.4, height=0.6];
  Rol           [label="Rol"];
  Usuario       [label="Usuario"];
  Categoria     [label="Categoria"];
  Producto      [label="Producto"];
  Lote          [label="Lote"];
  StockVencido  [label="StockVencido"];

  // Los movimientos de stock son entidades, no relaciones:
  // de ese modo las relaciones quedan sin atributos.
  IngresoMercaderia [label="IngresoMercaderia"];
  AjusteStock       [label="AjusteStock"];
  RetiroVencido     [label="RetiroVencido"];

  // ============ Relaciones (sin atributos) ============
  node [shape=diamond, style=filled, fillcolor="#F3E9DD", color="#444444", width=1.5, height=0.9];
  R_Asigna     [label="Asigna"];
  R_Clasifica  [label="Clasifica"];
  R_Agrupa     [label="Agrupa"];
  R_Vence      [label="Vence en"];
  R_Registra   [label="Registra"];
  R_Crea       [label="Crea"];
  R_Realiza    [label="Realiza"];
  R_Corrige    [label="Corrige"];
  R_Efectua    [label="Efectua"];
  R_Descuenta  [label="Descuenta"];

  // ============ Atributos ============
  node [shape=ellipse, style=filled, fillcolor="#FDFDFD", color="#444444", width=0.9, height=0.45];

  // -- Rol --
  A_nombreRol      [label=<<U>nombreRol</U>>];
  A_descripcionRol [label="descripcionRol"];

  // -- Usuario --
  A_nombreUsuario  [label=<<U>nombreUsuario</U>>];
  A_contrasena     [label="contraseña"];
  A_nombreCompleto [label="nombreCompleto"];
  A_estadoUsuario  [label="estadoUsuario"];

  // -- Categoria --
  A_nombreCategoria      [label=<<U>nombreCategoria</U>>];
  A_descripcionCategoria [label="descripcionCategoria"];

  // -- Producto (stockVigente, stockVencido y total son derivados de los lotes) --
  A_codigoProducto      [label=<<U>codigoProducto</U>>];
  A_nombreProducto      [label="nombreProducto"];
  A_descripcionProducto [label="descripcionProducto"];
  A_stockMinimo         [label="stockMinimo"];
  A_estadoProducto      [label="estadoProducto"];
  A_stockVigente        [label="stockVigente",     style="filled,dashed", fillcolor="#F7F7F7"];
  A_stockVencidoD       [label="stockVencido",     style="filled,dashed", fillcolor="#F7F7F7"];
  A_stockTotal          [label="stockTotalFisico", style="filled,dashed", fillcolor="#F7F7F7"];

  // -- Lote --
  A_nroLote      [label=<<U>nroLote</U>>];
  A_fechaVenc    [label="fechaVencimiento"];
  A_cantidadLote [label="cantidadLote"];

  // -- StockVencido --
  A_codigoEtiqueta  [label=<<U>codigoEtiqueta</U>>];
  A_cantidadVencida [label="cantidad"];

  // -- IngresoMercaderia --
  A_nroIngreso   [label=<<U>nroIngreso</U>>];
  A_cantIngreso  [label="cantidad"];
  A_fechaIngreso [label="fechaIngreso"];

  // -- AjusteStock --
  A_nroAjuste    [label=<<U>nroAjuste</U>>];
  A_cantidadReal [label="cantidadReal"];
  A_motivo       [label="motivo"];
  A_fechaAjuste  [label="fechaAjuste"];

  // -- RetiroVencido --
  A_nroRetiro   [label=<<U>nroRetiro</U>>];
  A_cantRetiro  [label="cantidad"];
  A_fechaRetiro [label="fechaRetiro"];

  // ============ Union de cada atributo con su entidad ============
  edge [len=1.0];
  Rol -- {A_nombreRol A_descripcionRol};
  Usuario -- {A_nombreUsuario A_contrasena A_nombreCompleto A_estadoUsuario};
  Categoria -- {A_nombreCategoria A_descripcionCategoria};
  Producto -- {A_codigoProducto A_nombreProducto A_descripcionProducto A_stockMinimo A_estadoProducto};
  Producto -- {A_stockVigente A_stockVencidoD A_stockTotal} [style=dashed];
  Lote -- {A_nroLote A_fechaVenc A_cantidadLote};
  StockVencido -- {A_codigoEtiqueta A_cantidadVencida};

  IngresoMercaderia -- {A_nroIngreso A_cantIngreso A_fechaIngreso};
  AjusteStock       -- {A_nroAjuste A_cantidadReal A_motivo A_fechaAjuste};
  RetiroVencido     -- {A_nroRetiro A_cantRetiro A_fechaRetiro};

  // ============ Entidad -- Relacion -- Entidad (con cardinalidad) ============
  edge [len=2.0, penwidth=1.3];

  Rol       -- R_Asigna    [label="1"];
  R_Asigna  -- Usuario     [label="N"];

  Categoria   -- R_Clasifica [label="1"];
  R_Clasifica -- Producto    [label="N"];

  // Un producto se agrupa en lotes; al vencer, el lote pasa a stock vencido
  Producto -- R_Agrupa     [label="1"];
  R_Agrupa -- Lote         [label="N"];
  Lote     -- R_Vence      [label="1"];
  R_Vence  -- StockVencido [label="N"];

  // Ingreso de mercaderia: crea el lote con su fecha de vencimiento
  Usuario           -- R_Registra        [label="1"];
  R_Registra        -- IngresoMercaderia [label="N"];
  IngresoMercaderia -- R_Crea            [label="N"];
  R_Crea            -- Lote              [label="1"];

  // Ajuste de stock: corrige la cantidad de un lote
  Usuario     -- R_Realiza   [label="1"];
  R_Realiza   -- AjusteStock [label="N"];
  AjusteStock -- R_Corrige   [label="N"];
  R_Corrige   -- Lote        [label="1"];

  // Retiro de mercaderia vencida: descuenta del lote vencido por su etiqueta
  Usuario       -- R_Efectua      [label="1"];
  R_Efectua     -- RetiroVencido  [label="N"];
  RetiroVencido -- R_Descuenta    [label="N"];
  R_Descuenta   -- StockVencido   [label="1"];
}
