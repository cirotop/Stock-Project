@startuml Diagrama_Entidad_Relacion
' Diagrama Entidad-Relación - Stock Project
' Basado en 04-Diccionario De Datos/Diccionario_de_Datos.md (version de claves naturales),
' 02-Requerimientos/Requerimientos_post 6ta entrevista.md y
' 03-Reglas De Negocio/Reglas_de_Negocio_6ta_entrevista.md.
' Alcance: solo control de stock. Fuera de alcance: ventas, facturacion, clientes,
' cuenta corriente, medios de pago, proveedores, caja y listas de precios.
' El diccionario no define IDs internos: cada entidad usa su clave natural como PK.

hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 5
skinparam class {
  BackgroundColor #FDFDFD
  BorderColor #444444
  ArrowColor #444444
  HeaderBackgroundColor #DDE7F3
}

' ===================== Seguridad =====================

entity "Rol" as Rol {
  * **nombreRol** : VARCHAR(20) <<PK>>  {Administrador | Empleado}
  --
    descripcionRol : VARCHAR(100)
}

entity "Usuario" as Usuario {
  * **nombreUsuario** : VARCHAR(30) <<PK>>
  --
  * contraseña : VARCHAR(255)  (hash)
  * nombreCompleto : VARCHAR(80)
  * nombreRol : VARCHAR(20) <<FK>>
  * estadoUsuario : BOOLEAN
}

' ===================== Catálogo =====================

entity "Categoria" as Categoria {
  * **nombreCategoria** : VARCHAR(50) <<PK>>
  --
    descripcionCategoria : VARCHAR(150)
}

entity "Producto" as Producto {
  * **codigoProducto** : VARCHAR(30) <<PK>>
  --
  * nombreProducto : VARCHAR(100)
    descripcionProducto : VARCHAR(200)
  * nombreCategoria : VARCHAR(50) <<FK>>
  * stockVigente : INT
  * stockMinimo : INT
    fechaVencimiento : DATE
  * estadoProducto : BOOLEAN
}

entity "StockVencido" as StockVencido {
  * **codigoEtiqueta** : VARCHAR(30) <<PK>>
  --
  * codigoProducto : VARCHAR(30) <<FK>>
  * cantidad : INT
  * fechaVencimiento : DATE
}

' ===================== Movimientos de stock =====================
' RN-07: cada movimiento guarda el usuario y la fecha.
' RN-08: el stock solo cambia a traves de estos movimientos.

entity "IngresoMercaderia" as IngresoMercaderia {
  * codigoProducto : VARCHAR(30) <<FK>>
  * cantidad : INT
  * fechaIngreso : DATE
  * fechaVencimiento : DATE
  * nombreUsuario : VARCHAR(30) <<FK>>
}

entity "AjusteStock" as AjusteStock {
  * codigoProducto : VARCHAR(30) <<FK>>
  * cantidadReal : INT
  * motivo : VARCHAR(150)
  * fechaAjuste : DATE
  * nombreUsuario : VARCHAR(30) <<FK>>
}

entity "RetiroVencido" as RetiroVencido {
  * codigoEtiqueta : VARCHAR(30) <<FK>>
  * cantidad : INT
  * fechaRetiro : DATE
  * nombreUsuario : VARCHAR(30) <<FK>>
}

' ===================== Relaciones =====================
' ||  = exactamente uno     |o = cero o uno
' |{  = uno o muchos        o{ = cero o muchos

Rol          ||--o{ Usuario            : "asigna"

Categoria    ||--o{ Producto           : "clasifica"
Producto     ||--o{ StockVencido       : "tiene vencido"

Producto     ||--o{ IngresoMercaderia  : "se incrementa por"
Producto     ||--o{ AjusteStock        : "se corrige por"
StockVencido ||--o{ RetiroVencido      : "se descuenta por"

Usuario      ||--o{ IngresoMercaderia  : "registra"
Usuario      ||--o{ AjusteStock        : "registra"
Usuario      ||--o{ RetiroVencido      : "registra"

note bottom of Producto
  RN-19: stock total fisico =
  stockVigente + suma(StockVencido.cantidad)
end note

note bottom of IngresoMercaderia
  El diccionario define los movimientos sin clave propia.
  Para implementarlos hace falta una clave subrogada
  (nroIngreso, nroAjuste, nroRetiro) o una compuesta.
end note

@enduml
