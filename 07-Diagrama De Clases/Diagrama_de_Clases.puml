@startuml Diagrama_de_Clases
' Diagrama de Clases - Stock Project
' Basado en 04-Diccionario De Datos/Diccionario_de_Datos.md (version de claves naturales),
' 02-Requerimientos/Requerimientos_post 6ta entrevista.md,
' 03-Reglas De Negocio/Reglas_de_Negocio_6ta_entrevista.md,
' 01-Entrevistas/Entrevista_#6 y 05-Caso De Uso/Casos_de_Uso.md.
' Alcance: solo control de stock. Fuera de alcance: ventas, facturacion, clientes,
' cuenta corriente, medios de pago, proveedores, caja y listas de precios.
' El diccionario no define IDs internos: cada clase se identifica por su clave natural.
' Cada operacion declara sus datos de entrada (parametros) y de salida (tipo de retorno).
' Cada clase es responsable de sus propios datos: el alta es una operacion de clase
' (subrayada, {static}) de la clase que se crea, y recibe el usuario que la ejecuta.
' Usuario solo conserva lo suyo: sesion, permisos y estado.
' El vencimiento se maneja por LOTE: cada caja ingresa con su numero de lote y a ese
' lote se le asigna la fecha de vencimiento impresa (RN-03, RN-04).

skinparam shadowing false
skinparam roundcorner 5
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam class {
  BackgroundColor #FDFDFD
  BorderColor #444444
  ArrowColor #444444
  HeaderBackgroundColor #DDE7F3
}

' ===================== Enumeraciones =====================

enum TipoRol {
  ADMINISTRADOR
  EMPLEADO
}

' ===================== Seguridad =====================

class Rol {
  - nombreRol : TipoRol  <<clave>>
  - descripcionRol : String
  --
  + {static} crear(nombreRol : TipoRol, descripcionRol : String, responsable : Usuario) : Rol
  + modificar(descripcionRol : String) : void
  + getNombreRol() : TipoRol
  + tienePermisoTotal() : boolean
}

class Usuario {
  - nombreUsuario : String  <<clave>>
  - contraseña : String
  - nombreCompleto : String
  - estadoUsuario : boolean
  --
  + {static} crear(nombreUsuario : String, contraseña : String, nombreCompleto : String, rol : Rol, responsable : Usuario) : Usuario
  + {static} autenticar(nombreUsuario : String, contraseña : String) : Usuario
  + modificar(nombreCompleto : String, rol : Rol) : void
  + darBaja() : void
  + cerrarSesion() : void
  + cambiarContraseña(contraseñaActual : String, contraseñaNueva : String) : boolean
  + esAdministrador() : boolean
  + estaActivo() : boolean
  + getNombreUsuario() : String
}

' ===================== Catálogo =====================

class Categoria {
  - nombreCategoria : String  <<clave>>
  - descripcionCategoria : String
  --
  + {static} crear(nombreCategoria : String, descripcionCategoria : String, responsable : Usuario) : Categoria
  + modificar(nombreCategoria : String, descripcionCategoria : String) : void
  + listarProductos() : Producto[]
}

class Producto {
  - codigoProducto : String  <<clave>>
  - nombreProducto : String
  - descripcionProducto : String
  - stockMinimo : int
  - estadoProducto : boolean
  --
  + {static} crear(codigoProducto : String, nombreProducto : String, descripcionProducto : String, categoria : Categoria, stockMinimo : int, responsable : Usuario) : Producto
  + modificar(nombreProducto : String, descripcionProducto : String, categoria : Categoria, stockMinimo : int) : void
  + darBaja() : void
  + buscarLote(nroLote : String) : Lote
  + tieneStockBajo() : boolean
  + estaActivo() : boolean
  + getLotesVigentes() : Lote[]
  + getLotesProximosAVencer(dias : int) : Lote[]
  + getStockVigente() : int
  + getStockVencido() : int
  + getStockTotalFisico() : int
}

class Lote {
  - nroLote : String  <<clave>>
  - fechaVencimiento : Date
  - cantidadLote : int
  --
  + {static} crear(producto : Producto, nroLote : String, cantidad : int, fechaVencimiento : Date) : Lote
  + aumentarCantidad(cantidad : int) : int
  + corregirCantidad(cantidadReal : int) : int
  + vencer(codigoEtiqueta : String) : StockVencido
  + estaVencido(fecha : Date) : boolean
  + estaProximoAVencer(dias : int) : boolean
  + getCantidadLote() : int
  + getFechaVencimiento() : Date
  + getProducto() : Producto
}

class StockVencido {
  - codigoEtiqueta : String  <<clave>>
  - cantidad : int
  --
  + descontar(cantidad : int) : int
  + estaRetirado() : boolean
  + getCantidad() : int
  + getLote() : Lote
}

' ===================== Movimientos de stock =====================
' RN-07: todo movimiento queda registrado con el usuario y la fecha.
' RN-08: el stock nunca se edita a mano, solo mediante estos movimientos.

abstract class MovimientoStock {
  - fecha : Date
  --
  + {abstract} aplicar() : boolean
  + getFecha() : Date
  + getUsuario() : Usuario
}

class IngresoMercaderia {
  - cantidad : int
  --
  + {static} registrar(producto : Producto, nroLote : String, cantidad : int, fechaVencimiento : Date, responsable : Usuario) : IngresoMercaderia
  + aplicar() : boolean
  + getCantidad() : int
}

class AjusteStock {
  - cantidadReal : int
  - motivo : String
  --
  + {static} registrar(lote : Lote, cantidadReal : int, motivo : String, responsable : Usuario) : AjusteStock
  + aplicar() : boolean
  + getMotivo() : String
}

class RetiroVencido {
  - cantidad : int
  --
  + {static} registrar(loteVencido : StockVencido, cantidad : int, responsable : Usuario) : RetiroVencido
  + aplicar() : boolean
  + getCantidad() : int
}

' ===================== Relaciones =====================

Rol "1" -- "0..*" Usuario : asigna >
Rol ..> TipoRol

Categoria "1" -- "0..*" Producto : clasifica >
Producto "1" *-- "0..*" Lote : se agrupa en >
Lote "1" -- "0..1" StockVencido : vence en >

MovimientoStock <|-- IngresoMercaderia
MovimientoStock <|-- AjusteStock
MovimientoStock <|-- RetiroVencido

Usuario "1" -- "0..*" MovimientoStock : registra >

IngresoMercaderia "0..*" --> "1" Lote : crea >
AjusteStock "0..*" --> "1" Lote : corrige >
RetiroVencido "0..*" --> "1" StockVencido : descuenta >

note bottom of Usuario
  RN-11: el alta, la modificacion y la baja de
  roles, usuarios, categorias y productos, y el
  ajuste de stock, exigen un usuario Administrador.
  Cada operacion lo verifica con esAdministrador()
  sobre el usuario que recibe como parametro.
  El ingreso, el retiro de vencidos y las consultas
  los puede ejecutar tambien el Empleado.
end note

note bottom of Producto
  Datos derivados de los lotes:
  stockVigente = suma de cantidadLote de los lotes no vencidos
  stockVencido = suma de cantidad de sus StockVencido
  stockTotalFisico = stockVigente + stockVencido   (RN-19)
end note

note bottom of Lote
  RN-04: todas las unidades del lote comparten
  la fecha de vencimiento impresa en la caja.
  RN-15: al vencer, su cantidad pasa a StockVencido
  con el codigo de etiqueta que se lee al retirarlo.
end note

@enduml
